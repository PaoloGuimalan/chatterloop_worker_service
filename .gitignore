# Variables containing binaries or performance records
*.o
*.a
*.so
*.obj

# Executables
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries compiled by 'go test'
*.test

# Output of the go coverage tool, generated by 'go test -coverprofile'
*.out

# Dependency directories (suggested if you do not use vendor mode)
# vendor/

# Go workspaces
go.work
go.work.sum

# Env files (contains sensitive API keys/passwords)
.env
.env.*
!.env.example

# IDE specific files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Cassandra 
secure-connect-chatterloop.zip
