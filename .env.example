# Copy this file to .env and fill in real values. Never commit .env itself.
DB_HOST=host
DB_NAME=name
DB_PORT=number
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-password-here
DB_DRIVER=database type

CASSANDRA_DB_HOST=YOUR_ASTRA_DB_ID-YOUR_REGION.db.astra.datastax.com
CASSANDRA_DB_NAME=chatterloop
CASSANDRA_DB_KEYSPACE=chatterloop
CASSANDRA_DB_PORT=29080
CASSANDRA_DB_USERNAME=YOUR_ASTRA_CLIENT_ID
CASSANDRA_DB_PASSWORD=YOUR_ASTRA_CLIENT_SECRET
CASSANDRA_DB_TOKEN=AstraCS:YOUR_CLIENT_ID:YOUR_GENERATED_SECRET_TOKEN
CASSANDRA_DB_BUNDLE=secure-connect-chatterloop.zip
CASSANDRA_DB_ENDPOINT=https://YOUR_ASTRA_DB_ID-YOUR_REGION.apps.astra.datastax.com

RABBITMQ_PROTOCOL=amqps
RABBITMQ_USER=vhost
RABBITMQ_PASS=pass
RABBITMQ_HOST=host
RABBITMQ_PORT=number
RABBITMQ_VHOST=vhost

EMAIL_HOST=<same value as user_service>
EMAIL_PORT=587
EMAIL_PASSWORD=<the JWT_TOKEN value — Django uses it as the SMTP password>

MONGODB_CLUSTER_HOST=YOUR_CLUSTER.xxxxx.mongodb.net
MONGODB_CLUSTER_USER=YOUR_MONGO_USER
MONGODB_CLUSTER_PASS=YOUR_MONGO_PASSWORD
MONGODB_DB=chatterloop

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY='{"privateKey": "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_BODY\n-----END PRIVATE KEY-----\n"}'